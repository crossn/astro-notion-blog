---
import type { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'

export interface Props {
  prevPost?: Post
  nextPost?: Post
}

const { prevPost, nextPost } = Astro.props
---

{
  (nextPost || prevPost) && (
    <nav class="post-relative-link" aria-label="前後の記事">
      {nextPost && (
        <a href={getPostLink(nextPost.Slug)} class="next-post">
          <span class="direction"><span class="arrow" aria-hidden="true">←</span> 次の記事</span>
          <span class="title">{nextPost.Title}</span>
        </a>
      )}
      {prevPost && (
        <a href={getPostLink(prevPost.Slug)} class="previous-post">
          <span class="direction">前の記事 <span class="arrow" aria-hidden="true">→</span></span>
          <span class="title">{prevPost.Title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-relative-link {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: 1.9rem;
  }

  .post-relative-link a {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    min-height: 4.5rem;
    padding: 0.6rem 0.25rem;
    border-radius: var(--radius-small);
    color: #3f394d;
    text-decoration: none;
  }

  .next-post {
    grid-column: 1;
  }

  .previous-post {
    grid-column: 2;
    text-align: right;
  }

  .direction {
    color: #6b6478;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .arrow {
    color: var(--color-interaction);
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .post-relative-link a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--color-interaction);
    text-underline-offset: 0.2em;
  }

  .post-relative-link a:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .post-relative-link {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .next-post,
    .previous-post {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
