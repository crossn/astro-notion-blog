---
import { Post } from '../lib/interfaces.ts'
import { existsSync } from 'node:fs'
import { filePath, getNotionFilePathParts } from '../lib/blog-helpers'

export interface Props {
  post: Post
  alt?: string
}

const { post, alt = 'post-featured-image' } = Astro.props

let image = ''
if (post.FeaturedImage && post.FeaturedImage.Url) {
  if (import.meta.env.DEV) {
    image = post.FeaturedImage.Url
  } else {
    try {
      const url = new URL(post.FeaturedImage.Url)
      const { directory, filename } = getNotionFilePathParts(url)
      if (existsSync(`public/notion/${directory}/${filename}`)) {
        image = filePath(url)
      }
    } catch {
      // Keep the post visible when its optional featured image is unavailable.
    }
  }
}
---

{
  image && (
    <div class="post-featured-image">
      <img src={image} alt={alt} />
    </div>
  )
}

<style>
  .post-featured-image {
    max-width: 100%;
    min-width: 0;
    padding: 0.6rem 0 0.2rem;
    overflow: hidden;
  }
  .post-featured-image img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 20rem;
    height: auto;
  }
</style>
