---
import * as interfaces from '../../lib/interfaces.ts'
import { buildHeadingId } from '../../lib/blog-helpers.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'

export interface Props {
  block: interfaces.Block
  headings: interfaces.Block[]
}

const { block, headings } = Astro.props

const id = buildHeadingId(block.Heading3)
---

{
  block.Heading3.IsToggleable ? (
    <details class="toggle">
      <summary>
        <a href={`#${id}`} id={id}>
          <h5>
            {block.Heading3.RichTexts.map((richText: interfaces.RichText) => (
              <RichText richText={richText} />
            ))}
          </h5>
        </a>
      </summary>
      <div>
        {block.Heading3.Children && (
          <NotionBlocks blocks={block.Heading3.Children} headings={headings} />
        )}
      </div>
    </details>
  ) : (
    <a href={`#${id}`} id={id}>
      <h5>
        {block.Heading3.RichTexts.map((richText: interfaces.RichText) => (
          <RichText richText={richText} />
        ))}
      </h5>
    </a>
  )
}

<style>
  h5 {
    margin: 0.9em 0 0.3em;
    color: var(--fg);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    h5 {
      font-size: 1.1rem;
    }
  }

  .toggle {
    margin: 1.2rem 0 0;
  }

  @media (max-width: 640px) {
    .toggle {
      margin: 1.1rem 0 0;
    }
  }

  .toggle > summary {
    display: flex;
    align-items: flex-start;
    gap: 0;
    padding-inline: 6px;
    color: inherit;
    cursor: pointer;
    fill: inherit;
    list-style: none;
    --toggle-caret-offset: 4px;
    border-radius: 6px;
  }

  .toggle > summary::-webkit-details-marker {
    display: none;
  }

  .toggle > summary::before {
    content: '▶';
    display: flex;
    flex: 0 0 24px;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: var(--toggle-caret-offset);
    margin-inline-start: 2px;
    color: rgb(125, 122, 117);
    font-size: 0.8em;
    line-height: 1;
    border-radius: 4px;
    transform-origin: center;
    transition: transform 120ms ease, background 120ms ease;
  }

  .toggle > summary:hover::before {
    background: rgba(55, 53, 47, 0.08);
  }

  .toggle[open] > summary::before {
    transform: rotate(90deg);
  }

  .toggle > summary > a {
    display: block;
    flex: 1 1 0;
    min-width: 1px;
    color: inherit;
    text-decoration: none;
  }

  .toggle > summary > a > h5 {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 2px;
    line-height: 1.3;
    word-break: break-word;
  }

  .toggle > div {
    margin-left: 36px;
  }
</style>
