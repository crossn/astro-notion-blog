---
import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import {
  getAllTags,
  getNumberOfPagesByTag,
  getPostsByTagAndPage,
} from '../../../../../lib/notion/client.ts'
import Layout from '../../../../../layouts/Layout.astro'
import BlogEditorialListing from '../../../../../components/BlogEditorialListing.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()

  const paths = await Promise.all(
    allTags.map((tag: SelectProperty) => {
      return getNumberOfPagesByTag(tag.name).then((numberOfPages: number) =>
        Array.from({ length: Math.max(0, numberOfPages - 1) }, (_, index) => ({
          params: { tag: tag.name, page: (index + 2).toString() },
        }))
      )
    })
  )

  return paths.flat()
}

const { tag = '', page = '2' } = Astro.params
const currentPage = Number.parseInt(page, 10)

const [posts, tags, numberOfPages] = await Promise.all([
  getPostsByTagAndPage(tag, currentPage),
  getAllTags(),
  getNumberOfPagesByTag(tag),
])
---

<Layout
  title={`Posts in ${tag} ${currentPage}/${numberOfPages}`}
  path={`/blog/tag/${tag}/page/${currentPage}`}
>
  <BlogEditorialListing
    posts={posts}
    tags={tags}
    currentPage={currentPage}
    numberOfPages={numberOfPages}
    tag={tag}
  />
</Layout>
