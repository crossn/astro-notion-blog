---
import type { SelectProperty } from '../../../lib/interfaces.ts'
import { NUMBER_OF_POSTS_PER_PAGE } from '../../../server-constants.ts'
import {
  getAllTags,
  getNumberOfPagesByTag,
  getPostsByTag,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import BlogEditorialListing from '../../../components/BlogEditorialListing.astro'

export async function getStaticPaths() {
  const allTags = await getAllTags()
  return allTags.map((tag: SelectProperty) => ({ params: { tag: tag.name } }))
}

const { tag } = Astro.params

const [posts, tags, numberOfPages] = await Promise.all([
  getPostsByTag(tag, NUMBER_OF_POSTS_PER_PAGE),
  getAllTags(),
  getNumberOfPagesByTag(tag),
])
---

<Layout title={`Posts in ${tag}`} path={`/blog/tag/${tag}`}>
  <BlogEditorialListing
    posts={posts}
    tags={tags}
    currentPage={1}
    numberOfPages={numberOfPages}
    tag={tag}
  />
</Layout>
