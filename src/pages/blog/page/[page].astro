---
import {
  getAllTags,
  getPostsByPage,
  getNumberOfPages,
} from '../../../lib/notion/client.ts'
import Layout from '../../../layouts/Layout.astro'
import BlogEditorialListing from '../../../components/BlogEditorialListing.astro'

export async function getStaticPaths() {
  const numberOfPages = await getNumberOfPages()

  return Array.from({ length: Math.max(0, numberOfPages - 1) }, (_, index) => ({
    params: { page: (index + 2).toString() },
  }))
}

const { page = '2' } = Astro.params
const currentPage = Number.parseInt(page, 10)

const [posts, tags, numberOfPages] = await Promise.all([
  getPostsByPage(currentPage),
  getAllTags(),
  getNumberOfPages(),
])
---

<Layout
  title={`Blog ${currentPage}/${numberOfPages}`}
  path={`/blog/page/${currentPage}`}
>
  <BlogEditorialListing
    posts={posts}
    tags={tags}
    currentPage={currentPage}
    numberOfPages={numberOfPages}
  />
</Layout>
