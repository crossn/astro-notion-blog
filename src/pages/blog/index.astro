---
import { NUMBER_OF_POSTS_PER_PAGE } from '../../server-constants.ts'
import {
  getAllTags,
  getAllPosts,
  getNumberOfPages,
} from '../../lib/notion/client.ts'
import { getPostLink } from '../../lib/blog-helpers.ts'
import Layout from '../../layouts/Layout.astro'
import BlogEditorialListing from '../../components/BlogEditorialListing.astro'

const allPosts = await getAllPosts()
const posts = allPosts.slice(0, NUMBER_OF_POSTS_PER_PAGE)
const [tags, numberOfPages] = await Promise.all([
  getAllTags(),
  getNumberOfPages(),
])
const signalPosts = allPosts.map((post) => ({
  slug: post.Slug,
  title: `${post.Icon?.Emoji ? `${post.Icon.Emoji} ` : ''}${post.Title}`,
  href: getPostLink(post.Slug),
}))
---

<Layout title="Blog" path="/blog">
  <BlogEditorialListing
    posts={posts}
    tags={tags}
    currentPage={1}
    numberOfPages={numberOfPages}
    signalPosts={signalPosts}
    signalsEndpoint="/api/blog-signals"
  />
</Layout>
