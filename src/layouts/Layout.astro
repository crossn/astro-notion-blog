---
import { ClientRouter } from 'astro:transitions'
import {
  PUBLIC_SITE_TITLE,
  PUBLIC_SITE_DESCRIPTION,
  PUBLIC_GA_TRACKING_ID,
  ENABLE_LIGHTBOX,
} from '../server-constants.ts'
import { getNavLink } from '../lib/blog-helpers.ts'
import '../styles/theme.css'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SiteGrowingPlant from '../components/SiteGrowingPlant.astro'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const siteTitle = title ? `${title} - ${PUBLIC_SITE_TITLE}` : PUBLIC_SITE_TITLE
const siteDescription = description ? description : PUBLIC_SITE_DESCRIPTION
const siteURL = new URL(path, Astro.site).toString()
const siteOGImage = new URL('/tsukurun-lab-og.png', Astro.site)

const navItems = [
  { label: 'Home', path: '/' },
  { label: 'Blog', path: '/blog' },
]
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={getNavLink('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={getNavLink('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={getNavLink('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#fffefa" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={PUBLIC_SITE_TITLE} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <ClientRouter />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <header class="header" style={{ position: 'relative', zIndex: 2 }}>
      <div class="site-title">
        <a href={getNavLink('/')}>
          <svg class="brandSprig" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
            <g class="brandSprigPaths">
              <path d="M24 43c2.7-8.5-1.6-17.2.2-37" />
              <path d="M24.3 22.2c3.7-7.4 9-11.7 15-13.1-.1 7.4-5.1 13.3-14.4 15.2" />
              <path d="M24.5 30.1c-6.7-1.7-11.7-5.7-15.4-11.5 7.2-.9 13.4 2.4 17.2 9.6" />
              <path d="M26.1 35.1c4.2-5.8 9.7-8.8 16.4-8.7-2 6.9-7.6 11.1-15.6 11.5" />
            </g>
          </svg>
          <span>{PUBLIC_SITE_TITLE}</span>
        </a>
      </div>

      <nav aria-label="主要ナビゲーション">
        <ul>
          {
            navItems.map(({ label, path: p }) => {
              const isActive =
                p === '/'
                  ? path === '/'
                  : path === p || path.startsWith(`${p}/`)
              const ariaCurrent = isActive
                ? path === p
                  ? 'page'
                  : 'location'
                : undefined

              return (
                <li key={label}>
                  <a
                    href={getNavLink(p)}
                    class={isActive ? 'active' : null}
                    aria-current={ariaCurrent}
                  >
                    {label}
                  </a>
                </li>
              )
            })
          }
        </ul>
      </nav>
    </header>
    <div class="container">
      <slot />
    </div>
    <footer class="footer">
      <div>
        <span>Powered by</span>
        <a href="https://github.com/otoyo/astro-notion-blog"
          >astro-notion-blog</a
        >
        <span> / tsukurun-Lab Edition</span>
      </div>
    </footer>

    <SiteGrowingPlant />
    {ENABLE_LIGHTBOX && <script is:inline src="/scripts/fslightbox.js" />}
  </body>
</html>

<style>
  .header {
    position: relative;
    display: flex;
    width: min(68rem, calc(100% - 2.5rem));
    min-height: 64px;
    box-sizing: border-box;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 auto;
    padding: 0.45rem 0;
    background: transparent;
  }
  .header::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(126, 111, 88, 0.14) 12%, rgba(126, 111, 88, 0.14) 88%, transparent);
    content: '';
  }
  .header .site-title {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.2rem, 1.7vw, 1.35rem);
    line-height: 1.15;
    letter-spacing: 0.015em;
    color: var(--color-ink);
  }
  .header .site-title a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }
  .brandSprig {
    display: block;
    width: 24px;
    height: 24px;
    flex: none;
    pointer-events: none;
  }
  .brandSprigPaths {
    fill: none;
    stroke: #737d6b;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (prefers-color-scheme: dark) {
    .brandSprigPaths { stroke: #c3ceb7; }
  }
  .header nav ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  @media (max-width: 640px) {
    .header {
      min-height: 58px;
      gap: 0.3rem;
    }

    .header .site-title {
      font-size: 1.12rem;
    }

    .header nav ul {
      gap: 0.1rem;
      font-size: 0.84rem;
    }
  }
  .header nav li :global(a) {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.55rem;
    color: var(--color-ink-muted);
    transition: color var(--motion-fast) ease;
  }
  .header nav li :global(a::after) {
    position: absolute;
    right: 0.55rem;
    bottom: 0.25rem;
    left: 0.55rem;
    height: 1px;
    background: var(--color-interaction);
    content: '';
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--motion-soft) ease;
  }
  .header nav li :global(a:hover),
  .header nav li :global(a.active) {
    color: var(--color-interaction-hover);
  }
  .header nav li :global(a:hover::after),
  .header nav li :global(a.active::after) {
    transform: scaleX(1);
  }
  .header nav li :global(a:focus-visible) {
    border-radius: var(--radius-small);
  }
  @media (max-width: 360px) {
    .brandSprig { display: none; }
  }

  .container {
    width: 100%;
    padding: 0 var(--space-page-gutter);
  }

  .footer {
    margin: var(--space-section) 0 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--wash-pink) 100%
    );
    border-top: 1px solid var(--color-border-subtle);
    padding: 2rem 1rem 1.5rem;
  }
  .footer span {
    color: var(--color-ink-muted);
  }
  .footer a {
    color: inherit;
  }
  .footer a:hover {
    color: var(--color-interaction-hover);
  }

  @media (max-width: 640px) {
    .footer {
      margin-top: 1.5rem;
      padding: 1.5rem 1rem 1.25rem;
    }
  }
</style>

<style is:global>
  * {
    box-sizing: border-box;
    word-break: break-word;
  }

  html,
  body {
    padding: 0;
    margin: 0;
    font-size: 16px;
  }

  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, Helvetica Neue, Segoe UI,
      Hiragino Kaku Gothic ProN, Hiragino Sans, ヒラギノ角ゴ ProN W3, Arial,
      メイリオ, Meiryo, sans-serif;
    /*-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen,
      Ubuntu, Cantarell, Fira Sans, Droid Sans, Helvetica Neue, sans-serif;
    */

    /*background-image: radial-gradient(#ddd 1px, transparent 1px),
      radial-gradient(#ddd 1px, transparent 1px);*/
    background-position: 0 0, 25px 25px;
    background-attachment: fixed;
    background-size: 50px 50px;

    /* Hack */
    overflow-x: hidden;

    -webkit-font-smoothing: antialiased;
  }

  figure {
    margin: 0;
    font-size: 0.85rem;
    color: #999;
    line-height: 1.8rem;
  }

  a {
    color: var(--accents-1);
    text-decoration: none;
  }
  a:hover {
    color: var(--accents-2);
  }

  mark {
    padding: var(--gap-quarter);
    border-radius: var(--radius);
    background: rgba(247, 212, 255, 0.8);
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: 2rem;
    font-weight: 700;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    line-height: 1.3;
    font-size: 1.2rem;
    font-weight: normal;
  }
  h2 > span.tag {
    border-radius: 4px;
    padding: 3px 9px;
    background: rgba(227, 226, 224, 0.5);
  }

  h3 {
    margin: 0;
    color: var(--fg);
    font-size: 1.2rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }

    h2 {
      font-size: 1.15rem;
    }

    h3 {
      font-size: 1.15rem;
    }
  }

  ol {
    color: #222;
    font-weight: 400;
    font-size: 0.9rem;
    line-height: 1.8rem;
  }
  p,
  ul {
    color: #222;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.8rem;
  }
  ul,
  ol {
    margin: 0;
    padding-inline-start: 1.5rem;
  }
  pre {
    margin: 0;
    white-space: pre;
    tab-size: 2;
  }
  pre :global(code) {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  hr {
    display: block;
    height: 1px;
    border: 0;
    margin: 0.3rem 0;
    background-color: #333;
  }

  code {
    font-size: 0.9rem;
    background: #f1f1f1;
    color: #eb5757;
    padding: 0.25rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
  }

  :not(pre) > code {
    color: #b84444;
  }

  table {
    color: #222;
    border-collapse: collapse;
  }

  table tr {
    vertical-align: middle;
  }

  table th {
    font-weight: 600;
    background-color: #f4f4f4;
  }

  table td,
  table th {
    font-size: 0.9rem;
    border: 1px solid #e4e4e4;
    padding: 0.5rem 1rem;
    line-height: 1.2rem;
  }
</style>
