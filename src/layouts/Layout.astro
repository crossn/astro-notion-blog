---
import { ClientRouter } from 'astro:transitions'
import {
  PUBLIC_SITE_TITLE,
  PUBLIC_SITE_DESCRIPTION,
  PUBLIC_GA_TRACKING_ID,
  ENABLE_LIGHTBOX,
} from '../server-constants.ts'
import { getNavLink } from '../lib/blog-helpers.ts'
import '../styles/theme.css'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const siteTitle = title ? `${title} - ${PUBLIC_SITE_TITLE}` : PUBLIC_SITE_TITLE
const siteDescription = description ? description : PUBLIC_SITE_DESCRIPTION
const siteURL = new URL(path, Astro.site).toString()
const siteOGImage = new URL('/default-og-image.png', Astro.site)

const navItems = [
  { label: 'Home', path: '/' },
  { label: 'Blog', path: '/blog' },
]
---

<!DOCTYPE html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={PUBLIC_SITE_TITLE} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <ClientRouter />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <header class="header" style={{ position: 'relative', zIndex: 2 }}>
      <div class="site-title">
        <a href={getNavLink('/')}>{PUBLIC_SITE_TITLE}</a>
      </div>

      <ul>
        {
          navItems.map(({ label, path: p }) => {
            const isActive =
              p === '/'
                ? path === '/'
                : path === p || path.startsWith(`${p}/`)
            const ariaCurrent = isActive
              ? path === p
                ? 'page'
                : 'location'
              : undefined

            return (
              <li key={label}>
                <a
                  href={getNavLink(p)}
                  class={isActive ? 'active' : null}
                  aria-current={ariaCurrent}
                >
                  {label}
                </a>
              </li>
            )
          })
        }
      </ul>
    </header>
    <div class="container">
      <slot />
    </div>
    <footer class="footer">
      <div>
        <span>Powered by</span>
        <a href="https://github.com/otoyo/astro-notion-blog"
          >astro-notion-blog</a
        >
        <span> / tsukurun-Lab Edition</span>
      </div>
    </footer>

    {ENABLE_LIGHTBOX && <script is:inline src="/scripts/fslightbox.js" />}
  </body>
</html>

<style>
  .header {
    display: block;
    padding: 0.7rem 0 0.3rem;
    text-align: center;
  }
  .header .site-title {
    margin: 0;
    padding: 0.15rem 0;
    font-weight: 400;
    font-size: clamp(1.3rem, 1.7vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: 0.035em;
    color: var(--color-ink);
  }
  .header .site-title a {
    color: inherit;
  }
  .header ul {
    list-style: none;
    margin: inherit;
    padding: 0.2rem 0 0.4rem;
    font-size: 1.1rem;
  }
  @media (max-width: 640px) {
    .header {
      padding: 0.6rem 0 0.2rem;
    }

    .header .site-title {
      font-size: 1.3rem;
    }

    .header ul {
      padding: 0.15rem 0 0.35rem;
      font-size: 1rem;
    }
  }
  .header ul li {
    display: inline-block;
    padding: 0 0.9rem;
  }
  .header ul li :global(a) {
    position: relative;
    display: inline-block;
    padding: 0.15rem 0.1rem 0.3rem;
    color: var(--color-ink-muted);
    transition: color var(--motion-fast) ease;
  }
  .header ul li :global(a::after) {
    position: absolute;
    right: 0.1rem;
    bottom: 0;
    left: 0.1rem;
    height: 1px;
    background: var(--color-interaction);
    content: '';
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--motion-soft) ease;
  }
  .header ul li :global(a:hover),
  .header ul li :global(a.active) {
    color: var(--color-interaction-hover);
  }
  .header ul li :global(a:hover::after),
  .header ul li :global(a.active::after) {
    transform: scaleX(1);
  }
  .header ul li :global(a:focus-visible) {
    border-radius: var(--radius-small);
  }

  .container {
    width: 100%;
    padding: 0 var(--space-page-gutter);
  }

  .footer {
    margin: var(--space-section) 0 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--wash-pink) 100%
    );
    border-top: 1px solid var(--color-border-subtle);
    padding: 2rem 1rem 1.5rem;
  }
  .footer span {
    color: var(--color-ink-muted);
  }
  .footer a {
    color: inherit;
  }
  .footer a:hover {
    color: var(--color-interaction-hover);
  }

  @media (max-width: 640px) {
    .footer {
      margin-top: 1.5rem;
      padding: 1.5rem 1rem 1.25rem;
    }
  }
</style>

<style is:global>
  * {
    box-sizing: border-box;
    word-break: break-word;
  }

  html,
  body {
    padding: 0;
    margin: 0;
    font-size: 16px;
  }

  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, Helvetica Neue, Segoe UI,
      Hiragino Kaku Gothic ProN, Hiragino Sans, ヒラギノ角ゴ ProN W3, Arial,
      メイリオ, Meiryo, sans-serif;
    /*-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Oxygen,
      Ubuntu, Cantarell, Fira Sans, Droid Sans, Helvetica Neue, sans-serif;
    */

    /*background-image: radial-gradient(#ddd 1px, transparent 1px),
      radial-gradient(#ddd 1px, transparent 1px);*/
    background-position: 0 0, 25px 25px;
    background-attachment: fixed;
    background-size: 50px 50px;

    /* Hack */
    overflow-x: hidden;

    -webkit-font-smoothing: antialiased;
  }

  figure {
    margin: 0;
    font-size: 0.85rem;
    color: #999;
    line-height: 1.8rem;
  }

  a {
    color: var(--accents-1);
    text-decoration: none;
  }
  a:hover {
    color: var(--accents-2);
  }

  mark {
    padding: var(--gap-quarter);
    border-radius: var(--radius);
    background: rgba(247, 212, 255, 0.8);
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: 2rem;
    font-weight: 700;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    line-height: 1.3;
    font-size: 1.2rem;
    font-weight: normal;
  }
  h2 > span.tag {
    border-radius: 4px;
    padding: 3px 9px;
    background: rgba(227, 226, 224, 0.5);
  }

  h3 {
    margin: 0;
    color: var(--fg);
    font-size: 1.2rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }

    h2 {
      font-size: 1.15rem;
    }

    h3 {
      font-size: 1.15rem;
    }
  }

  ol {
    color: #222;
    font-weight: 400;
    font-size: 0.9rem;
    line-height: 1.8rem;
  }
  p,
  ul {
    color: #222;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.8rem;
  }
  ul,
  ol {
    margin: 0;
    padding-inline-start: 1.5rem;
  }
  pre {
    margin: 0;
    white-space: pre;
    tab-size: 2;
  }
  pre :global(code) {
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  hr {
    display: block;
    height: 1px;
    border: 0;
    margin: 0.3rem 0;
    background-color: #333;
  }

  code {
    font-size: 0.9rem;
    background: #f1f1f1;
    color: #eb5757;
    padding: 0.25rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
  }

  :not(pre) > code {
    color: #b84444;
  }

  table {
    color: #222;
    border-collapse: collapse;
  }

  table tr {
    vertical-align: middle;
  }

  table th {
    font-weight: 600;
    background-color: #f4f4f4;
  }

  table td,
  table th {
    font-size: 0.9rem;
    border: 1px solid #e4e4e4;
    padding: 0.5rem 1rem;
    line-height: 1.2rem;
  }
</style>
