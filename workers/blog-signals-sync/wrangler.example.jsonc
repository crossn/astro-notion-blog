{
  // Bundle/local-test template only. It has no production D1 binding or Cron.
  "name": "tsukurun-blog-signals-sync-example",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "triggers": { "crons": [] },
  // 3B-2b: add d1_databases with binding BLOG_SIGNALS_DB,
  // database_name tsukurun-blog-likes, and the actual Cloudflare database_id.
  // Add the GA_SERVICE_ACCOUNT_JSON secret in Cloudflare, never in this file.
  // Enable "0 0 * * *" only after the real GA/D1 checks are complete.
  "vars": {
    "GA_PROPERTY_ID": "REPLACE_WITH_GA4_PROPERTY_ID",
    "SITE_HOSTNAME": "REPLACE_WITH_SITE_HOSTNAME",
    "SITE_BASE_PATH": "",
    "GA_TIME_ZONE": "Asia/Tokyo"
  }
}
